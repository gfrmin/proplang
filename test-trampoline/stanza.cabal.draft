-- The trampoline suite's stanza, DRAFTED at the oracle phase (the
-- draft-stanza precedent: proplang.cabal is frozen; this stanza is
-- spliced into it at the freeze commit, under the sitting's key).
-- The oracle-phase red run compiles with this stanza's EXACT flag
-- set (the `warnings` common stanza: -Wall -Werror
-- -Wincomplete-patterns -Wincomplete-uni-patterns; GHC2021) — the
-- flag-faithful clause.

test-suite trampoline
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Trampoline.hs
    other-modules:    Anchors
                    , OracleWorld
                    , Streams
    hs-source-dirs:   test-trampoline, test
    build-depends:    base
                    , directory
                    , process
                    , proplang
                    , tasty
                    , tasty-hunit
    build-tool-depends: proplang:proplang-host
    default-language: GHC2021
