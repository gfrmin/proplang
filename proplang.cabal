cabal-version:      3.0
name:               proplang
version:            0.1.0.0
synopsis:           proplang (Proposition Language) — typed port, frozen-oracle build
description:
  Haskell typed port of proplang per typed-port-spec.md. Phase 1: src/ are
  signature stubs; test/ and audit/ are the frozen oracle (see CLAUDE.md).
build-type:         Simple
extra-doc-files:    CLAUDE.md
                    design.md
                    interface.md
                    typed-port-spec.md
                    KERNEL.md
                    membrane-wire.md

common warnings
    ghc-options: -Wall -Werror -Wincomplete-patterns -Wincomplete-uni-patterns

library
    import:           warnings
    exposed-modules:  PropLang.Belief
                      PropLang.Syntax
                      PropLang.Eval
                      PropLang.Enumerate
                      PropLang.Report
                      PropLang.Membrane
                      PropLang.Host
                      PropLang.Lattice
                      PropLang.Purchase
    hs-source-dirs:   src
    -- src depends on GHC BOOT LIBRARIES ONLY (amended at the jp
    -- increment's freeze-boundary repair, 2026-07-28, author's key:
    -- the original words "src depends on base ONLY (frozen-oracle
    -- decision: keeps the audit's `ghc -isrc` ablation compiles
    -- package-DB-free)" were falsified by the jp DP's lazy memo
    -- table (Data.Map); the rationale SURVIVES as re-stated --
    -- containers ships inside every bare GHC install
    -- (lib/package.conf.d), so the frozen ablation runner's plain
    -- `ghc --make -isrc` compiles unchanged: 6/6 PASS executed
    -- against the containers-importing src BEFORE this edit)
    build-depends:    base >=4.16 && <5
                    , containers
    default-language: GHC2021

executable proplang-host
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base
                    , proplang
    default-language: GHC2021

test-suite transport
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Transport.hs
    hs-source-dirs:   test-transport
    build-depends:    base
                    , directory
                    , process
                    , proplang
                    , tasty
                    , tasty-hunit
    build-tool-depends: proplang:proplang-host
    default-language: GHC2021


-- THE EXACT ORACLE (frozen at exact-freeze-r0; red by design until
-- Phase 2 lands src — the increment-protocol form). The R13 swap into
-- test/ composes with the R11 retirement at the Phase-2 close (five
-- green suites import the old Anchors until they retire).

test-suite exact-acceptance
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Acceptance.hs
    other-modules:    Anchors, Streams, OracleWorld
    hs-source-dirs:   test
    build-depends:    base
                    , proplang
                    , tasty
                    , tasty-hunit
    default-language: GHC2021

test-suite exact-properties
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Properties.hs
    other-modules:    OracleWorld
    hs-source-dirs:   test
    build-depends:    base
                    , proplang
                    , tasty
                    , tasty-hunit
    default-language: GHC2021

test-suite lawful
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Lawful.hs
    hs-source-dirs:   test-lawful
    build-depends:    base
                    , proplang
                    , tasty
                    , tasty-hunit
    default-language: GHC2021

test-suite lawful-independence
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Independence.hs
