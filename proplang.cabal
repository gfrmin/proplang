test-suite battery
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Battery.hs
    other-modules:    Anchors
                    , OracleWorld
                    , Streams
    hs-source-dirs:   test-battery, test
    build-depends:    base
                    , proplang
                    , tasty
                    , tasty-hunit
